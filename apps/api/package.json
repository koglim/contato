{
  "name": "@contatocerto/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "tsx --test integration/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@contatocerto/shared": "workspace:*",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "openai": "^7.8.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6"
  }
}
