{
  "name": "ContatoCerto - Outbox Dispatcher",
  "active": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "budget",
      "name": "Budget",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function httpResponse(response) {\r\n  if (typeof response?.body !== \"string\") return response;\r\n  if (!response.body.trim()) return { ...response, body: null };\r\n  try { return { ...response, body: JSON.parse(response.body) }; }\r\n  catch { return { ...response, body: null }; }\r\n}\nconst items = $input.all();\nif (items.length !== 1) throw new Error('dispatcher_expects_one_budget');\nconst input = items[0].json;\nconst started_at = input.started_at ?? Date.now();\nconst count = input.count ?? 0;\nif (count >= 10 || Date.now() - started_at >= 45000) return [];\nreturn [{ json: { started_at, count } }];"
      }
    },
    {
      "id": "claim-next",
      "name": "Claim next",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.CONTATOCERTO_API_BASE_URL + '/internal/channel/outbound/next/claim' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text",
              "outputPropertyName": "body"
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "ContatoCerto Internal API"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "id": "deliver-shared",
      "name": "Deliver shared",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "={{ $vars.CONTATOCERTO_DELIVERY_WORKFLOW_ID }}",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "continue-draining",
      "name": "Continue draining",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function httpResponse(response) {\r\n  if (typeof response?.body !== \"string\") return response;\r\n  if (!response.body.trim()) return { ...response, body: null };\r\n  try { return { ...response, body: JSON.parse(response.body) }; }\r\n  catch { return { ...response, body: null }; }\r\n}\nconst items = $input.all();\nif (items.length !== 1) throw new Error('dispatcher_expects_one_result');\nconst result = items[0].json;\nif (result.action !== 'complete' || result.needs_reconciliation) return [];\nconst budget = $('Budget').item.json;\nreturn [{ json: { started_at: budget.started_at, count: budget.count + 1 } }];"
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Budget",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Budget": {
      "main": [
        [
          {
            "node": "Claim next",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim next": {
      "main": [
        [
          {
            "node": "Deliver shared",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Deliver shared": {
      "main": [
        [
          {
            "node": "Continue draining",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Continue draining": {
      "main": [
        [
          {
            "node": "Budget",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 105,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveExecutionProgress": false,
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
