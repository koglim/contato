# PostgreSQL / PostGIS used by Docker Compose
POSTGRES_USER=contatocerto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contatocerto
POSTGRES_PORT=5432

# The application and database tooling use this URL. Keep its password in .env only.
DATABASE_URL=postgresql://contatocerto:change-me@localhost:5432/contatocerto

# API
API_PORT=3333
# Temporary protection for internal administrative endpoints. Use a strong secret in production.
INTERNAL_API_KEY=change-me

# Service Resolution fuzzy calibration (numbers from 0 to 1; defaults shown)
SERVICE_RESOLUTION_FUZZY_THRESHOLD=0.53
SERVICE_RESOLUTION_FUZZY_AMBIGUITY_GAP=0.10

# Server-side HeiGIT / openrouteservice geocoding. Keep the key secret.
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.heigit.org/pelias/v1
LOCATION_RESOLUTION_CONFIDENCE_THRESHOLD=0.85
LOCATION_RESOLUTION_AMBIGUITY_GAP=0.10

# Optional server-side OpenAI fallback for extracting location only. Disabled by default.
OPENAI_API_KEY=
MESSAGE_INTERPRETATION_FALLBACK_ENABLED=false
MESSAGE_INTERPRETATION_FALLBACK_MODEL=gpt-5.6-luna
MESSAGE_INTERPRETATION_FALLBACK_TIMEOUT_MS=5000

# Short-lived state used while collecting a missing search location.
SEARCH_CONVERSATION_TTL_MINUTES=30
SEARCH_CONVERSATION_PROCESSING_LEASE_SECONDS=60

# Lease used to recover a channel message left in processing after a process crash.
CHANNEL_INBOUND_PROCESSING_LEASE_SECONDS=60

# Lease used by n8n while it sends a claimed outbound message through Evolution.
CHANNEL_OUTBOUND_PROCESSING_LEASE_SECONDS=60

# Web dashboard (server-side only; do not expose these as NEXT_PUBLIC variables)
CONTATOCERTO_API_URL=http://localhost:3333
DASHBOARD_PROFESSIONAL_ID=
DASHBOARD_DEMO_PASSWORD=
DASHBOARD_SESSION_SECRET=
# Passwordless professional authentication rollout. Keep false until production provisioning is ready.
PROFESSIONAL_AUTH_ENABLED=false
# API-only HMAC/encryption pepper. Required only when PROFESSIONAL_AUTH_ENABLED=true; never expose as NEXT_PUBLIC.
PROFESSIONAL_AUTH_PEPPER=
# Conversational AI: disabled by default. No paid call is made while false.
CONVERSATION_AI_ENABLED=false
# Required only when enabling conversational AI; select after real-model evaluation.
OPENAI_CONVERSATION_MODEL=
# Maximum time for each Conversation AI interpretation/composition call.
OPENAI_CONVERSATION_TIMEOUT_MS=20000
# Legacy aliases CONTEXTUAL_CONVERSATION_ENABLED and CONTEXTUAL_CONVERSATION_MODEL
# remain accepted temporarily for a safe staged configuration migration.
