# PostgreSQL / PostGIS used by Docker Compose
POSTGRES_USER=contatocerto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contatocerto
POSTGRES_PORT=5432

# The application and database tooling use this URL. Keep its password in .env only.
DATABASE_URL=postgresql://contatocerto:change-me@localhost:5432/contatocerto

# API
API_PORT=3333
# Temporary protection for internal administrative endpoints. Use a strong secret in production.
INTERNAL_API_KEY=change-me

# Web dashboard (server-side only; do not expose these as NEXT_PUBLIC variables)
CONTATOCERTO_API_URL=http://localhost:3333
DASHBOARD_PROFESSIONAL_ID=
DASHBOARD_DEMO_PASSWORD=
