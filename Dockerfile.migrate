FROM node:22-alpine

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Installs only the root administrative dependencies, including node-pg-migrate and pg.
RUN pnpm install --filter contatocerto --frozen-lockfile

COPY database database

CMD ["sh", "-c", "echo 'No database command specified. Use: pnpm db:migrate, pnpm db:seed, or pnpm db:rollback.'"]
